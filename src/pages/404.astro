---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <main style="text-align: center; padding: 5rem 1rem;">
    <h1 style="font-size: 4rem; font-weight: bold; margin-bottom: 1rem;">404</h1>
    <p style="font-size: 1.25rem; color: #666; margin-bottom: 2rem;">抱歉，您访问的页面不存在。</p>
    <a href="/" style="display: inline-block; padding: 0.5rem 1.5rem; background: #1a73e8; color: #fff; border-radius: 4px; text-decoration: none;">返回首页</a>
  </main>
</BaseLayout>
