---
---

<div id="search-modal" class="search-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="search-dialog">
    <div class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        id="search-input" 
        type="search" 
        placeholder="搜索文章标题、简介、标签... (ESC 关闭)" 
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close-btn" class="search-close-btn" aria-label="关闭搜索">
        <kbd>ESC</kbd>
      </button>
    </div>

    <div id="search-results" class="search-results-list">
      <div class="search-hint">输入关键词开始检索...</div>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(3rem, 12vh, 8rem);
    padding-inline: 1rem;
    animation: fadeIn 0.15s ease-out;
  }

  .search-modal-backdrop.open {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .search-dialog {
    width: 100%;
    max-width: 640px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow-lg), 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-surface);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1.05rem;
    color: var(--text-primary);
    font-family: inherit;
  }

  #search-input::placeholder {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .search-close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .search-close-btn kbd {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
  }

  .search-results-list {
    padding: 0.75rem;
    overflow-y: auto;
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .search-hint {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  :global(.search-result-item) {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background: var(--bg-secondary);
    border-color: var(--border-color);
  }

  :global(.search-item-header) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  :global(.search-item-title) {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  :global(.search-result-item:hover .search-item-title),
  :global(.search-result-item.selected .search-item-title) {
    color: var(--accent);
  }

  :global(.search-item-date) {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  :global(.search-item-desc) {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-item-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.search-item-tag) {
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-light);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
</style>

<script is:inline>
  (() => {
    let indexData = null;
    let selectedIndex = -1;

    async function loadIndex() {
      if (indexData) return;
      try {
        const res = await fetch('/search-index.json');
        indexData = await res.json();
      } catch (err) {
        console.error('Failed to load search index:', err);
      }
    }

    function initSearch() {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      const resultsContainer = document.getElementById('search-results');
      const closeBtn = document.getElementById('search-close-btn');

      if (!modal) return;

      function openSearch() {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        loadIndex();
        setTimeout(() => input?.focus(), 50);
      }

      function closeSearch() {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        if (input) input.value = '';
        renderDefault();
      }

      function renderDefault() {
        if (resultsContainer) {
          resultsContainer.innerHTML = '<div class="search-hint">输入关键词开始检索...</div>';
        }
        selectedIndex = -1;
      }

      function highlightMatch(text, query) {
        if (!text) return '';
        const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        return text.replace(regex, '<mark style="background: rgba(37,99,235,0.2); color: inherit; padding: 0 2px; border-radius: 2px;">$1</mark>');
      }

      function performSearch(query) {
        const q = query.trim().toLowerCase();
        if (!q) {
          renderDefault();
          return;
        }
        if (!indexData) return;

        const filtered = indexData.filter((item) => {
          const inTitle = item.title?.toLowerCase().includes(q);
          const inDesc = item.description?.toLowerCase().includes(q);
          const inTags = item.tags?.some((t) => t.toLowerCase().includes(q));
          return inTitle || inDesc || inTags;
        });

        if (filtered.length === 0) {
          resultsContainer.innerHTML = '<div class="search-hint">未找到匹配文章</div>';
          selectedIndex = -1;
          return;
        }

        resultsContainer.innerHTML = filtered.map((item, idx) => `
          <a href="${item.url}" class="search-result-item ${idx === 0 ? 'selected' : ''}" data-idx="${idx}">
            <div class="search-item-header">
              <span class="search-item-title">${highlightMatch(item.title, q)}</span>
              <span class="search-item-date">${item.date}</span>
            </div>
            ${item.description ? `<p class="search-item-desc">${highlightMatch(item.description, q)}</p>` : ''}
            ${item.tags && item.tags.length ? `
              <div class="search-item-tags">
                ${item.tags.map(t => `<span class="search-item-tag">#${t}</span>`).join('')}
              </div>
            ` : ''}
          </a>
        `).join('');

        selectedIndex = 0;
      }

      function updateSelected(items) {
        items.forEach((item, idx) => {
          if (idx === selectedIndex) {
            item.classList.add('selected');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('selected');
          }
        });
      }

      modal.onclick = (e) => {
        if (e.target === modal) closeSearch();
      };

      if (closeBtn) closeBtn.onclick = closeSearch;

      if (input) {
        input.oninput = (e) => performSearch(e.target.value);
      }

      // Keydown listener
      if (!window.__hasSearchKeydown) {
        window.__hasSearchKeydown = true;
        window.addEventListener('keydown', (e) => {
          const m = document.getElementById('search-modal');
          const r = document.getElementById('search-results');
          if (!m) return;

          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            m.classList.contains('open') ? closeSearch() : openSearch();
          } else if (e.key === 'Escape' && m.classList.contains('open')) {
            closeSearch();
          } else if (m.classList.contains('open') && r) {
            const items = r.querySelectorAll('.search-result-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
              e.preventDefault();
              selectedIndex = (selectedIndex + 1) % items.length;
              updateSelected(items);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              updateSelected(items);
            } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
              e.preventDefault();
              items[selectedIndex].click();
            }
          }
        });
      }

      window.openSearchModal = openSearch;
    }

    document.addEventListener('astro:page-load', initSearch);
  })();
</script>
