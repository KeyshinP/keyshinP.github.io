---
interface Props {
  umamiWebsiteId?: string;
  umamiSrc?: string;
  cloudflareToken?: string;
}

const {
  umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '',
  umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js',
  cloudflareToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || '',
} = Astro.props;
---

{umamiWebsiteId && (
  <script is:inline async defer src={umamiSrc} data-website-id={umamiWebsiteId} data-astro-rerun></script>
)}

{cloudflareToken && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cloudflareToken}"}`} data-astro-rerun></script>
)}
