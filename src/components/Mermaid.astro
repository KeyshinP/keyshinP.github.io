<script is:inline>
  (() => {
    async function renderMermaid() {
      const mermaidCodeElements = document.querySelectorAll('code.language-mermaid, pre.mermaid');
      if (!mermaidCodeElements.length) return;

      try {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        const isDark = document.documentElement.classList.contains('dark');
        
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'default',
          fontFamily: 'inherit',
          securityLevel: 'loose'
        });

        for (let i = 0; i < mermaidCodeElements.length; i++) {
          const el = mermaidCodeElements[i];
          const pre = el.closest('pre') || el;
          const code = el.textContent || '';
          const container = document.createElement('div');
          container.className = 'mermaid-container';
          const id = `mermaid-svg-${Date.now()}-${i}`;
          
          try {
            const { svg } = await mermaid.render(id, code.trim());
            container.innerHTML = svg;
            if (pre.parentNode) {
              pre.parentNode.replaceChild(container, pre);
            }
          } catch (err) {
            console.warn('Mermaid rendering failed for block:', err);
          }
        }
      } catch (err) {
        console.warn('Failed to load Mermaid library:', err);
      }
    }

    document.addEventListener('astro:page-load', renderMermaid);
  })();
</script>

<style>
  :global(.mermaid-container) {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
    overflow-x: auto;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  :global(.mermaid-container svg) {
    max-width: 100%;
    height: auto;
  }
</style>
